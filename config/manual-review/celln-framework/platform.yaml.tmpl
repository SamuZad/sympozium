  tools:
    - ref: {name: @@TOOL@@, revision: @@TOOL_REVISION@@}
  lifecycles: [direct-one-shot, harness-one-shot, enduring]
  routes:
    - provider: review-fixture
      protocol: openai-chat
      models: [review-uppercase]
      endpointOrigins:
        - https://review-provider-@@REVIEW@@.celln-review-a-@@REVIEW@@.svc:8443
        - https://review-provider-@@REVIEW@@.celln-review-b-@@REVIEW@@.svc:8443
      auth: secret
  ceilings:
    maxTurns: 2
    maxModelRequests: 4
    maxOutputTokens: 2048
    maxParentLeaseSeconds: 600
    maxTurnSeconds: 120
