apiVersion: sympozium.ai/v1alpha1
kind: AgentRun
metadata:
  name: model-uppercase
  namespace: celln-review-a-@@REVIEW@@
  labels: {sympozium.ai/celln-review: "@@REVIEW@@"}
spec:
  agentRef: review-agent
  agentId: default
  sessionKey: review-model-one-shot
  task: celln
  systemPrompt: Use the selected uppercase tool exactly once and return only its text field.
  model: {connectionRef: review-model, model: review-uppercase}
  backend: celln
  executionLifecycle: one-shot
  timeout: 2m
  cleanup: delete
  cellnSelection:
    runtimeRef: review-runtime
    toolRefs: []
    clusterToolRefs: [{name: @@TOOL@@, revision: @@TOOL_REVISION@@}]
